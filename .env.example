# Local values only. Copy to .env, then fill blank secrets yourself.
# Spring Boot does not load this file automatically; see README PowerShell loader.
DB_URL=jdbc:mysql://127.0.0.1:3306/smartcrm_l8?connectionTimeZone=Asia/Ho_Chi_Minh
DB_USER=smartcrm
DB_PASSWORD=
# Independent random secrets, each at least 32 bytes. Never expose in VITE_*.
SERVICE_API_KEY=
JWT_SECRET=
# Optional first-run account creation. No existing account is overwritten.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_PASSWORD=
SURVEY_PUBLIC_BASE_URL=http://localhost:5173/khao-sat
GATEWAY_SIMULATE_FAILURE=false
SURVEY_EXPIRY_DAYS=7
SURVEY_SCHEDULER_ENABLED=true
# Optional frontend proxy override (PowerShell environment before npm run dev):
# VITE_API_TARGET=http://127.0.0.1:8080
# Test resources have isolated localhost:3307 defaults; never point them at a working DB.
# Optional overrides: TEST_DB_URL, TEST_DB_USER, TEST_DB_PASSWORD.
# Browser E2E only: E2E_BASE_URL, E2E_SERVICE_KEY, E2E_SURVEY_TOKEN,
# E2E_TICKET_CODE, E2E_PASSWORD, E2E_MANAGER_USERNAME,
# E2E_MARKETING_USERNAME, E2E_DIRECTOR_USERNAME; see frontend/README.md.
