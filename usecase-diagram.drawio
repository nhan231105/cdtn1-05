Module Phiếu bảo hành (L2/L4) là hệ thống ngoài phạm vi L8, chỉ phát sự kiện “phiếu chuyển sang ĐÃ ĐÓNG”." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="54" y="978" width="1132" height="18" as="geometry"/></mxCell><mxCell id="lg_n3" value="UC01 và UC04 dùng chung UC02 qua «include»; UC08 mở rộng UC05 (xuất đúng danh sách đang lọc)." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="54" y="995" width="1132" height="18" as="geometry"/></mxCell><mxCell id="lg_n4" value="Use case được đặc tả chi tiết: UC03 – Gửi phản hồi khảo sát hài lòng." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="54" y="1012" width="1132" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>